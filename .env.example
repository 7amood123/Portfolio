# Absolute public URL of the site, with no trailing slash.
# Defaults to the GitHub Pages project site: https://7amood123.github.io/Portfolio
# Used for the canonical URL, Open Graph image, and sitemap.
# Override it when deploying to a different host or custom domain.
VITE_SITE_URL=https://7amood123.github.io/Portfolio

# Public base path. Defaults to /Portfolio/ for GitHub Pages
# (the repository name is case-sensitive).
# Use / for root-hosted deployments (Netlify, Vercel, custom domain).
VITE_BASE=/Portfolio/
